NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database (Can provide full URL or discrete credentials)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=itsm
DATABASE_USER=root
DATABASE_PASS=
DATABASE_URL=mysql://root@localhost:3306/itsm

# Authentication
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-example
JWT_EXPIRES_IN=60m
ADMIN_PASSWORD=samplepassword

# Reverse proxy hops in front of the app (0 = direct, 1 = behind one nginx)
TRUST_PROXY=0
# Optional: enables Sentry error monitoring when set
SENTRY_DSN=
# Expose the API reference in production (off by default; admin-gated when on)
DOCS_ENABLED=false

